{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "name": "Cream", "color": "#fbf8f3" },
        { "slug": "contrast", "name": "Espresso", "color": "#2b1d12" },
        { "slug": "accent-1", "name": "Pine", "color": "#2f5d4a" },
        { "slug": "accent-2", "name": "Honey", "color": "#e8b04b" },
        { "slug": "accent-3", "name": "Roast", "color": "#5b2a1e" },
        { "slug": "accent-4", "name": "Bark", "color": "#6b5a4a" },
        { "slug": "accent-5", "name": "Oat", "color": "#f1e9dd" },
        { "slug": "accent-6", "name": "Pine 20%", "color": "#d5e0da" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "manrope", "name": "Body", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif" },
        { "slug": "fira-code", "name": "Mono", "fontFamily": "ui-monospace, Consolas, monospace" },
        { "slug": "serif", "name": "Serif", "fontFamily": "Georgia, Cambria, \"Times New Roman\", serif" }
      ]
    },
    "layout": { "contentSize": "720px", "wideSize": "1200px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--manrope)" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "700", "letterSpacing": "-0.01em" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent-1)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--accent-1)", "text": "#ffffff" },
        "border": { "radius": "8px" },
        ":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "#ffffff" } }
      }
    }
  }
}
