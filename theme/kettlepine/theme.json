{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "base", "name": "Cream", "color": "#fbf7f1" },
        { "slug": "contrast", "name": "Espresso", "color": "#24170e" },
        { "slug": "accent-1", "name": "Pine", "color": "#2c5a46" },
        { "slug": "accent-2", "name": "Honey", "color": "#e3a33b" },
        { "slug": "accent-3", "name": "Roast", "color": "#5b2a1e" },
        { "slug": "accent-4", "name": "Bark", "color": "#6b5a4a" },
        { "slug": "accent-5", "name": "Oat", "color": "#f2eadf" },
        { "slug": "accent-6", "name": "Pine 20%", "color": "#d7e2dc" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "manrope", "name": "DM Sans", "fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
          "fontFace": [ { "fontFamily": "DM Sans", "fontWeight": "100 1000", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans.woff2" ] } ] },
        { "slug": "serif", "name": "Fraunces", "fontFamily": "Fraunces, Georgia, Cambria, \"Times New Roman\", serif",
          "fontFace": [ { "fontFamily": "Fraunces", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces.woff2" ] } ] },
        { "slug": "fira-code", "name": "Mono", "fontFamily": "ui-monospace, Consolas, monospace" }
      ]
    },
    "layout": { "contentSize": "760px", "wideSize": "1240px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--manrope)", "fontSize": "1.0625rem", "lineHeight": "1.65" },
    "spacing": { "blockGap": "1.25rem" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "600", "letterSpacing": "-0.02em", "lineHeight": "1.1" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent-1)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--accent-1)", "text": "#ffffff" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
        "typography": { "fontWeight": "600", "fontSize": "1rem" },
        ":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "#ffffff" } }
      }
    }
  }
}
